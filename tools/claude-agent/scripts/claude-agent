#!/usr/bin/env bash
# claude-agent: run commands as the GitHub App "viserion-claude-agent", not as an engineer.
#
#   claude-agent token [--repo NAME ...]       print a one-hour installation token
#   claude-agent check [--repo NAME ...]       list the repositories the token can reach
#   claude-agent launch [--repo NAME ...] -- CMD...
#                                              run CMD with git and gh acting as the App
#
# The private key is read from CLAUDE_AGENT_APP_KEY_FILE (default
# ~/.config/claude-agent/app-key.pem, mode 600) or from the output of
# CLAUDE_AGENT_APP_KEY_CMD (for a secret manager). Tokens last one hour, so a
# session that runs longer has to be relaunched.
set -euo pipefail

APP_ID="${CLAUDE_AGENT_APP_ID:-5240375}"
APP_SLUG="${CLAUDE_AGENT_APP_SLUG:-viserion-claude-agent}"
ORG="${CLAUDE_AGENT_ORG:-westernmilling}"
API="${GITHUB_API_URL:-https://api.github.com}"
KEY_FILE="${CLAUDE_AGENT_APP_KEY_FILE:-$HOME/.config/claude-agent/app-key.pem}"
KEY_CMD="${CLAUDE_AGENT_APP_KEY_CMD:-}"
REPOS=()

die() { echo "claude-agent: $*" >&2; exit 1; }
b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

read_key() {
  if [ -n "$KEY_CMD" ]; then
    bash -c "$KEY_CMD"
  else
    [ -r "$KEY_FILE" ] || die "no private key at $KEY_FILE (set CLAUDE_AGENT_APP_KEY_FILE or CLAUDE_AGENT_APP_KEY_CMD)"
    [ "$(stat -c %a "$KEY_FILE")" = 600 ] || die "$KEY_FILE must have mode 600"
    cat "$KEY_FILE"
  fi
}

app_jwt() {
  local now header payload signature
  now=$(date +%s)
  header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
  payload=$(printf '{"iat":%d,"exp":%d,"iss":%s}' $((now - 60)) $((now + 540)) "$APP_ID" | b64url)
  signature=$(printf '%s.%s' "$header" "$payload" | openssl dgst -sha256 -sign <(read_key) -binary | b64url)
  printf '%s.%s.%s' "$header" "$payload" "$signature"
}

api() {
  local method=$1 path=$2 token=$3 body=${4:-} args=()
  [ -z "$body" ] || args=(-H "Content-Type: application/json" -d "$body")
  curl -fsS -X "$method" "$API$path" \
    -H "Authorization: Bearer $token" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    ${args[@]+"${args[@]}"}
}

mint_token() {
  local jwt id body='{}'
  if [ -n "${CLAUDE_AGENT_TEST_TOKEN:-}" ]; then echo "$CLAUDE_AGENT_TEST_TOKEN"; return; fi
  jwt=$(app_jwt)
  id=${CLAUDE_AGENT_INSTALLATION_ID:-$(api GET "/orgs/$ORG/installation" "$jwt" | jq -r .id)}
  { [ -n "$id" ] && [ "$id" != null ]; } || die "$APP_SLUG is not installed on $ORG"
  if [ ${#REPOS[@]} -gt 0 ]; then
    body=$(printf '%s\n' "${REPOS[@]}" | jq -R . | jq -sc '{repositories: .}')
  fi
  api POST "/app/installations/$id/access_tokens" "$jwt" "$body" | jq -r .token
}

parse_repos() {
  while [ $# -gt 0 ] && [ "$1" != -- ]; do
    case $1 in
      --repo) [ $# -ge 2 ] || die "--repo needs a name"; REPOS+=("$2"); shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done
  REST=("$@")
}

cmd=${1:-}
[ $# -eq 0 ] || shift
REST=()

case $cmd in
  jwt) app_jwt ;;
  token) parse_repos "$@"; mint_token ;;
  check)
    parse_repos "$@"
    token=$(mint_token)
    api GET /installation/repositories "$token" | jq -r '.repositories[].full_name'
    ;;
  launch)
    parse_repos "$@"
    [ "${REST[0]:-}" = -- ] && [ ${#REST[@]} -gt 1 ] || die "usage: launch [--repo NAME] -- CMD..."
    REST=("${REST[@]:1}")
    token=$(mint_token)
    bot_id=${CLAUDE_AGENT_BOT_ID:-$(curl -fsS "$API/users/${APP_SLUG}%5Bbot%5D" | jq -r .id)}
    { [ -n "$bot_id" ] && [ "$bot_id" != null ]; } || die "could not look up the bot user for $APP_SLUG"
    scratch=$(mktemp -d)
    trap 'rm -rf "$scratch"' EXIT

    # Act as the App: its token, its identity, and none of the engineer's credentials.
    export GH_TOKEN=$token GH_CONFIG_DIR=$scratch/gh GIT_TERMINAL_PROMPT=0
    unset GITHUB_TOKEN GH_ENTERPRISE_TOKEN SSH_AUTH_SOCK
    export GIT_AUTHOR_NAME="$APP_SLUG[bot]" GIT_COMMITTER_NAME="$APP_SLUG[bot]"
    export GIT_AUTHOR_EMAIL="$bot_id+$APP_SLUG[bot]@users.noreply.github.com"
    export GIT_COMMITTER_EMAIL=$GIT_AUTHOR_EMAIL
    # Ignore the engineer's git config (helpers, signing keys); send SSH remotes over HTTPS.
    export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
    export GIT_CONFIG_COUNT=3
    export GIT_CONFIG_KEY_0=credential.helper
    export GIT_CONFIG_VALUE_0='!f() { echo username=x-access-token; echo "password=$GH_TOKEN"; }; f'
    export GIT_CONFIG_KEY_1=url.https://github.com/.insteadOf GIT_CONFIG_VALUE_1=git@github.com:
    export GIT_CONFIG_KEY_2=url.https://github.com/.insteadOf GIT_CONFIG_VALUE_2=ssh://git@github.com/

    status=0
    "${REST[@]}" || status=$?
    exit "$status"
    ;;
  *)
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
esac
